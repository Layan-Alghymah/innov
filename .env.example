# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/innovation_platform?schema=public"

# Auth.js (v5) — generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Optional: base URL for callbacks (usually auto-detected in dev / on Vercel)
# AUTH_URL="http://localhost:3000"

# Seed admin (production): set these before running the seed on a cloud DB.
# If SEED_ADMIN_PASSWORD is omitted in production, a random one is generated
# and printed once by `npm run db:seed`.
# SEED_ADMIN_EMAIL="admin@yourdomain.sa"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Future: Microsoft Entra ID (Azure AD) SSO — leave empty until enabled
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
